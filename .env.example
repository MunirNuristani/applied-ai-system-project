# Copy to .env (which is git-ignored) and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check which model your AI Studio project lists with a free quota, then set it here.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Stop making live calls after this many per day (Pacific time). Keep it under your quota.
# GEMINI_DAILY_BUDGET=18
# Seconds to wait for each Gemini call before falling back to local rules.
# GEMINI_TIMEOUT=120
